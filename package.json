    "build:lite": "node mods/build-lite.mjs",
    "test": "node tests/run-all.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jquery": "^3.7.1",
    "jquery-confirm": "^3.3.0"
